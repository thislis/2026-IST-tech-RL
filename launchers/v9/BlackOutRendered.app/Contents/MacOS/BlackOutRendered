#!/bin/bash
# Exec-only launcher; the supplied game and observation renderer are untouched.
set -euo pipefail
V9_LAUNCH_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../../../.." && pwd)"
for V9_LAUNCH_ARG in "$@"; do
    case "$V9_LAUNCH_ARG" in
        -nographics|-no-graphics|-force-gfx-null)
            echo 'v9 requires rendering for all provided graphic observation channels' >&2
            exit 64
            ;;
    esac
done
exec "$V9_LAUNCH_ROOT/builds/BlackOut.app/Contents/MacOS/RLGame2026" -batchmode "$@"
