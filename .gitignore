# Shared: code/ (versioned source, tests, configs, contracts, launchers,
# templates and dependency locks), docs/ (plans, history and authored reports).
# Do not ignore *.json, *.yaml, *.lock or launcher *.app directories globally.
# code/shared/docker-image.env is a shared image pin, not credentials.

# Local experiments, weights, datasets, game binaries and submissions.
/logs/
/artifacts/

# Prevent historical tool defaults from adding outputs at the root.
/reports/
/checkpoints/
/data/
/builds/
/submission/
/submissions/
/experiments/
/wandb/
/runs/
/tensorboard/

# Python environments, generated packages and caches.
.venv/
venv/
.unity/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.ipynb_checkpoints/
.coverage
.coverage.*
coverage.xml
htmlcov/
build/
dist/

# Weights, model exports and telemetry wherever generated.
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.log
*.pid
*.pid.lock
events.out.tfevents.*

# Local credentials/settings. Sanitized examples remain shareable.
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.local.env
.aws/
.ssh/
.secrets/
.codex/config.local.toml
.vscode/
.idea/
files_directory.md

# OS and editor temporary files.
.DS_Store
._*
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
