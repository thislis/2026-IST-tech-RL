#!/bin/bash
# Exec-only launcher; the supplied game and observation renderer are untouched.
set -euo pipefail
V10_LAUNCH_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
while [[ ! -f "$V10_LAUNCH_ROOT/code/shared/project_paths.py" ]]; do
    [[ "$V10_LAUNCH_ROOT" != / ]] || { echo "Project root not found" >&2; exit 1; }
    V10_LAUNCH_ROOT="$(dirname -- "$V10_LAUNCH_ROOT")"
done
for V10_LAUNCH_ARG in "$@"; do
    case "$V10_LAUNCH_ARG" in
        -nographics|-no-graphics|-force-gfx-null)
            echo 'v9 requires rendering for all provided graphic observation channels' >&2
            exit 64
            ;;
    esac
done
exec "$V10_LAUNCH_ROOT/artifacts/builds/BlackOut.app/Contents/MacOS/RLGame2026" -batchmode "$@"
