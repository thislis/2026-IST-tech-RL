{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blackout.local/schemas/policy_matrix_v1.schema.json",
  "title": "BlackOut common-condition policy matrix v1",
  "type": "object",
  "required": ["schema_version", "created_at_utc", "matrix_config", "results", "ranking"],
  "properties": {
    "schema_version": {"const": "blackout.policy_matrix.v1"},
    "created_at_utc": {"type": "string"},
    "matrix_config": {
      "type": "object",
      "required": [
        "seeds", "side_swap", "opponent_id", "opponent_sha256",
        "opponent_policy_seeds", "executable_sha256", "winner_source"
      ],
      "properties": {
        "seeds": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "side_swap": {"const": true},
        "opponent_id": {"type": "string"},
        "opponent_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "opponent_policy_seeds": {
          "type": "object",
          "additionalProperties": {"type": "integer"}
        },
        "executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "winner_source": {"const": "terminal_info.winner"}
      }
    },
    "results": {
      "type": "object",
      "required": ["random", "scripted", "ippo"]
    },
    "ranking": {
      "type": "array",
      "items": {"enum": ["random", "scripted", "ippo"]},
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true
    }
  }
}
